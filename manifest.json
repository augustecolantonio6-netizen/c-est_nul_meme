{
  "manifest_version": 3,
  "name": "C'est nul !",
  "version": "1.0.0",
  "description": "Joue le son de Homer Simpson lorsque N, U et L sont maintenues simultanément.",
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/homer.mp3"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}